rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny — no reads or writes unless explicitly allowed.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Avatars — readable by any authenticated user, writable only by owner.
    // Path: avatars/{userId}
    // Constraints: max 5 MB, JPEG or PNG only.
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }
  }
}
