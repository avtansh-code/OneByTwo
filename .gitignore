# ────────────────────────────────────────
# One By Two — .gitignore
# Covers: Flutter, Dart, Node.js, Firebase, macOS, Windows, IDEs
# ────────────────────────────────────────

# ── Flutter / Dart ──────────────────────
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Note: pubspec.lock IS committed (this is an application package, not a
# library — see https://dart.dev/tools/pub/glossary#lockfile). Committing
# the lock file is what allows CI's ios/Podfile.lock to remain in sync.
doc/api/
*.dart.js
*.info.json
*.js_
*.js.deps
*.js.map

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart
lib/generated_plugin_registrant.dart
*.locator.dart
*.router.dart

# Flutter version manager

# Coverage
coverage/
test/.test_coverage.dart

# ── Node.js / Cloud Functions ───────────
functions/node_modules/
functions/lib/
functions/.tsbuildinfo
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Firebase ────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
storage-debug.log
database-debug.log
firebase-export-*

# ── Environment & secrets ──────────────
.env
.env.*
*.jks
*.keystore
key.properties
google-services.json
GoogleService-Info.plist
firebase_app_id_file.json
firebase_options.dart

# ── Firebase setup scripts ─────────────
scripts/firebase/config.env
scripts/firebase/_artifacts/
.secrets/

# ── IDE / editor ────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ── macOS ───────────────────────────────
.DS_Store
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/
DerivedData/
Pods/

# ── Windows ─────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Linux ───────────────────────────────
*~

# ── Android ─────────────────────────────
android/.gradle/
android/captures/
android/local.properties
android/GeneratedPluginRegistrant.java
android/app/debug/
android/app/profile/
android/app/release/

# ── iOS ─────────────────────────────────
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Runner/GeneratedPluginRegistrant.*

# ── Fastlane ────────────────────────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# ── Lefthook ────────────────────────────
lefthook-local.yml

# ── Secrets / credentials ─────────────────────────────
secrets/

# FVM Version Cache
.fvm/